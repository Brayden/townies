{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "your-game",
  "main": "worker.ts",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "vars": {
    "TOWNIES_AUTH_MODE": "account",
    "BETTER_AUTH_URL": "https://your-game.example.com",
    "TOWNIES_MAINTENANCE": "false"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "your-game-accounts",
      "database_id": "YOUR_D1_DATABASE_ID",
      "migrations_dir": "drizzle"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "TOWNS",
        "class_name": "Town"
      },
      {
        "name": "RESIDENTS",
        "class_name": "ResidentCoordinator"
      }
    ]
  },
  "migrations": [
    {
      "tag": "town-objects-v1",
      "new_sqlite_classes": ["Town", "ResidentCoordinator"]
    }
  ],
  "account_id": "YOUR_CLOUDFLARE_ACCOUNT_ID",
  "routes": [
    {
      "pattern": "your-game.example.com",
      "custom_domain": true
    }
  ]
}
